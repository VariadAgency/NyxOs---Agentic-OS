# NyxOS server mode — copy to infra/.env (chmod 600) and fill in the required values.
# Docker Compose reads this file for variable substitution and passes it to the `api` container.

# ─── Required ────────────────────────────────────────────────────────────────────────────────────
# Password of the bundled Postgres database (any long random string, e.g. `openssl rand -hex 24`).
NYXOS_DB_PASSWORD=
# Key for the encrypted secret store (API keys, bot tokens): 32 random bytes, base64 (`openssl rand -base64 32`).
# Keep it: without it, stored secrets cannot be decrypted.
NYXOS_SECRETS_KEY=

# ─── Access ──────────────────────────────────────────────────────────────────────────────────────
# Port on 127.0.0.1 where the web app and API are published (default 47800).
NYXOS_PORT=47800
# Extra host names allowed to open NyxOS besides localhost (comma separated, e.g. a Tailscale name).
# Setting this REQUIRES NYXOS_AUTH_READS=1 (the server refuses to start otherwise).
NYXOS_ALLOWED_HOSTS=
# 1 = reading endpoints also require the passkey login (needed as soon as others can reach the host).
NYXOS_AUTH_READS=
# SSH target of this server as seen from your Mac (host alias from ~/.ssh/config or user@host). Enables the
# server terminal and connection commands in the Server tab. Empty = feature hidden.
NYXOS_SERVER_SSH_HOST=
# Optional host name whose TLS certificate the Server tab checks every 5 minutes (e.g. api.example.com).
NYXOS_HOST_PROBE_HOST=

# ─── Projects ────────────────────────────────────────────────────────────────────────────────────
# Absolute path of your main project folder as the server sees it. Used to write answered decisions into
# ENTSCHEIDUNGEN.md next to a task's GOAL.md. Empty = decisions stay in NyxOS only.
NYXOS_PROJECT_ROOT=
# Overrides where decision files may be written (defaults to NYXOS_PROJECT_ROOT).
NYXOS_DECISIONS_ROOT=
# Folder under which the manual import endpoints (/api/entries/import/goals|audit) may read. Empty = disabled.
NYXOS_IMPORT_ROOT=

# ─── Nyx (assistant) ─────────────────────────────────────────────────────────────────────────────
# Token from `claude setup-token` (Claude subscription). Used only by the `agent` container (profile agent).
CLAUDE_CODE_OAUTH_TOKEN=
# Shared secret between the API and the agent container (any long random string, `openssl rand -hex 32`).
NYXOS_WORKER_TOKEN=
# Model alias the agent uses for Nyx (default haiku).
NYXOS_HAIKU_MODEL=haiku
# Optional fallback engine over an Anthropic-compatible HTTP API (used when the CLI engine is unavailable).
NYXOS_HAIKU_API_KEY=
NYXOS_HAIKU_API_BASE_URL=
NYXOS_HAIKU_API_MODEL=
# 0 = do not run the scheduled briefing/recap jobs.
NYXOS_HAIKU_SCHEDULER=
# Models for autonomous task sessions and their reviewer (defaults: claude-opus-5-5 / sonnet).
NYXOS_WORKER_MODEL=
NYXOS_CRITIC_MODEL=

# ─── Telegram (optional) ─────────────────────────────────────────────────────────────────────────
# Bot token from @BotFather. Can also be entered in Settings → Telegram (stored encrypted).
TELEGRAM_BOT_TOKEN=
# Public HTTPS address of the Telegram mini app, if you expose one.
NYXOS_TELEGRAM_MINIAPP_URL=

# ─── Idea links (optional) ───────────────────────────────────────────────────────────────────────
# Public base URL used in shared idea links (default: the address NyxOS was opened with).
NYXOS_IDEALINK_BASE_URL=
# Extra host names allowed ONLY for the public idea-link pages (/i/*).
NYXOS_IDEALINK_HOSTS=

# ─── Push notifications (profile push, optional) ─────────────────────────────────────────────────
# Address of the ntfy service as your phone reaches it (e.g. http://nyxos.tailnet:2586). Empty = the phone
# cannot reach the built-in service; the settings then offer ntfy.sh instead.
NTFY_PUBLIC_URL=
# Access token for ntfy, if you enabled authentication there.
NTFY_TOKEN=

# ─── Voice (profile voice, optional) ─────────────────────────────────────────────────────────────
# Speech-recognition model and loaded voices (empty = defaults from infra/nyx-voice/nyx_voice/catalog.py).
NYX_STT_MODEL=
NYX_TTS_VOICES=
# Default German / English voice (empty = built-in choice with automatic fallback).
NYX_TTS_DEFAULT=
NYX_TTS_DEFAULT_EN=
# Real-time-factor limits before falling back to a faster voice.
NYX_MAX_DEFAULT_RTF=
NYX_MAX_DEFAULT_RTF_STREAMING=
# Pronunciation dictionary: all | piper | off.
NYX_LEXICON=
# Pocket TTS sound tuning (empty = defaults).
NYX_POCKET_DECODE_STEPS=
NYX_POCKET_TEMP=
NYX_POCKET_NOISE_CLAMP=
# Recognition language: auto | de | en.
NYX_LANGUAGE=
